#########
# ALIAS #
#########

# Enable aliases to be sudo’ed
alias sudo="sudo "

# general
alias c="clear"
alias open="xdg-open"
alias o="open"

# list dir
alias ll="ls -alhF"
alias lltr="ll -tr"
alias la="ls -lA"
alias l="ls -CF"

# navigation
alias ..="cd .."
alias ...="cd ../../../"
alias ....="cd ../../../../"
alias .....="cd ../../../../"
alias .4="cd ../../../../"
alias .5="cd ../../../../.."

#alias -="cd -"

# defaults for built-ins (verbose and interactive, colors)
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -iv'
alias grep="grep -i --color=auto"
alias mkdir="mkdir -p"
alias df='df -h'

# browser
alias ff="/bin/firefox"
alias chrome="/bin/google-chrome-stable"
alias browser=chrome

# git
alias gitsub="git submodule init && git submodule update --recursive"
alias gac="git commit -am"

# tmp helper
alias tmpDir='cd $(mktemp -d)'

# edit dotfiles
alias eA='$EDITOR ~/dotfiles/aliases'
alias eB='$EDITOR ~/.bashrc'
alias eP='$EDITOR ~/.profile'
alias eG='$EDITOR ~/.gitconfig'
alias rB='source ~/.bashrc'


alias serve="python -m http.server 11111"

# python / pip / pipenv
alias psh="pipenv shell"
alias pr="pipenv run"
alias pi="pipenv install -d"
alias pri="pipenv remove && pipenv install -d"
alias pu="pipenv update -d"


# ViUR development
alias kill_server="pkill app_server -ef -9 ; pkill gunicorn -ef -9 ; pkill gcloud-tasks-emulator -ef -9; pkill -9 -f \"viur run\""
